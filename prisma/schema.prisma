// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String                @id @default(cuid())
  number            Int?                  @unique // 스태프 번호 (수동 입력)
  name              String                @unique // 성명
  password          String                // 해시된 비밀번호
  role              String                // "admin", "manager", "staff"
  phone             String?               // 휴대폰번호
  daouId            String?               // 다우오피스4.0 ID
  daouPw            String?               // 다우오피스4.0 PW
  refundAppId       String?               // 환급관리자어플 ID
  refundAppPw       String?               // 환급관리자어플 PW
  memo              String?               // 메모(비고)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  checkItems        StoreCheckItem[]
  comments          StoreComment[]
  notices           Notice[]
  attendances       Attendance[]
  voucherDistributions VoucherDistribution[] // 받은 상품권 지급 기록
  voucherReturns    VoucherReturn[]       // 반납한 상품권 기록
  distributedBy     VoucherDistribution[] @relation("DistributedBy") // 관리자가 지급한 기록
  returnConfirmedBy VoucherReturn[]       @relation("ReturnConfirmedBy") // 관리자가 확인한 반납 기록
  adminReceives     AdminVoucherReceive[] // 관리자가 주최측으로부터 받은 기록
  adminReturns      AdminVoucherReturn[]  // 관리자가 주최측에 반납한 기록
}

model VoucherDistribution {
  id                String   @id @default(cuid())
  staffId           String   // 받는 스태프
  quantity          Int      // 지급 매수
  date              String   // 지급 날짜 "2026-02-10"
  distributedAt     DateTime // 지급 일시
  staffConfirmed    Boolean  @default(false) // 스태프 수령 확인
  createdBy         String   // 지급한 관리자
  createdAt         DateTime @default(now())
  
  staff             User     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  distributor       User     @relation("DistributedBy", fields: [createdBy], references: [id])
  
  @@index([staffId])
  @@index([date])
  @@index([createdBy])
}

model VoucherReturn {
  id                String   @id @default(cuid())
  staffId           String   // 반납하는 스태프
  quantity          Int      // 반납 매수
  distributedQty    Int      // 배부한 매수 (수령 총합 - 반납 매수)
  date              String   // 반납 날짜 "2026-02-10"
  returnedAt        DateTime // 반납 일시
  confirmedBy       String?  // 회수 확인한 관리자
  confirmedAt       DateTime? // 회수 확인 일시
  createdAt         DateTime @default(now())
  
  staff             User     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  confirmer         User?    @relation("ReturnConfirmedBy", fields: [confirmedBy], references: [id])
  
  @@index([staffId])
  @@index([date])
}

model AdminVoucherReceive {
  id                String   @id @default(cuid())
  adminId           String   // 받는 관리자
  quantity          Int      // 수령 매수
  date              String   // 수령 날짜 "2026-02-10"
  receivedAt        DateTime // 수령 일시
  createdAt         DateTime @default(now())
  
  admin             User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  
  @@index([adminId])
  @@index([date])
}

model AdminVoucherReturn {
  id                String   @id @default(cuid())
  adminId           String   // 반납하는 관리자
  quantity          Int      // 반납 매수
  date              String   // 반납 날짜 "2026-02-10"
  returnedAt        DateTime // 반납 일시
  createdAt         DateTime @default(now())
  
  admin             User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  
  @@index([adminId])
  @@index([date])
}

model Notice {
  id                String   @id @default(cuid())
  title             String   // 제목
  content           String   // 내용
  isPinned          Boolean  @default(false) // 상단 고정 여부
  createdBy         String   // 작성자 User ID
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  author            User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  
  @@index([createdBy])
  @@index([createdAt])
}

model Attendance {
  id                String   @id @default(cuid())
  userId            String
  date              String   // "2026-02-10"
  status            String   // "normal", "late", "absent"
  reason            String?  // 지각/결근 사유
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model Store {
  id                String            @id @default(cuid())
  serialNumber      Int               @unique // 일련번호 (수동 입력)
  name              String            // 점포명
  businessNumber    String            @unique // 사업자번호
  ownerName         String            // 대표자명
  ownerPhone        String            // 대표자 연락처
  address           String            // 주소
  mapLink           String            // 지도 링크
  products          String            // 품목
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  checkItems        StoreCheckItem[]
  comments          StoreComment[]
}

model StoreCheckItem {
  id                String   @id @default(cuid())
  storeId           String
  checkType         String   // "사업자등록증", "교육이수확인증", "이행각서", "어플로그인", "어플설치"
  checked           Boolean  @default(false)
  lastModifiedBy    String?  // User ID
  lastModifiedAt    DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  store             Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  lastModifier      User?    @relation(fields: [lastModifiedBy], references: [id], onDelete: SetNull)
  
  @@unique([storeId, checkType])
}

model StoreComment {
  id                String   @id @default(cuid())
  storeId           String
  content           String
  createdBy         String   // User ID
  lastModifiedBy    String?  // User ID (수정된 경우)
  lastModifiedAt    DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  store             Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  author            User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  
  @@index([storeId])
}
